# ===================================
# Application Settings
# ===================================

# Required: Set to 'development' or 'production'
ENVIRONMENT=development

# Required: Secret key for signing JWT tokens
SECRET_KEY=your-secret-key-here

# Required: JWT configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ===================================
# Database Configuration
# ===================================

# PostgreSQL (production)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_learning

# SQLite (development)
# DATABASE_URL=sqlite:///./ai_learning.db

# ===================================
# AI/ML Services
# ===================================

# Required: OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# AZURE_OPENAI_ENDPOINT=your-azure-endpoint
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# ===================================
# Authentication & Security
# ===================================

# Required for production: Set to 'https' in production
SCHEME=http

# CORS: Comma-separated list of allowed origins
# Example: http://localhost:3000,https://yourapp.com
CORS_ORIGINS=http://localhost:3000

# Optional: Rate limiting
RATE_LIMIT_PER_MINUTE=60

# ===================================
# Email Configuration (optional)
# ===================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# EMAIL_FROM=noreply@yourapp.com

# ===================================
# File Storage
# ===================================
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=your-cdn-domain.com

# ===================================
# Monitoring & Logging
# ===================================
# SENTRY_DSN=your-sentry-dsn
# LOG_LEVEL=INFO

# ===================================
# Feature Flags
# ===================================
# ENABLE_EMAIL_VERIFICATION=false
# ENABLE_RATE_LIMITING=true
# MAINTENANCE_MODE=false

# ===================================
# Web3/Wallet Configuration (optional)
# ===================================
# WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-infura-key
# WALLET_CONNECT_PROJECT_ID=your-walletconnect-project-id
# CHAIN_ID=1  # Ethereum Mainnet

# ===================================
# Social Login (optional)
# ===================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_TEAM_ID=your-apple-team-id
# APPLE_KEY_ID=your-apple-key-id
# APPLE_PRIVATE_KEY=your-apple-private-key
