<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AI Learning</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ai_learning_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	
	<!-- Allow querying wallet apps for deep links -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>metamask</string>
		<string>cbwallet</string>
		<string>phantom</string>
		<string>google</string>
	</array>

	<!-- Permissions for App Store submission -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Allow recording audio and video for stories and voice features.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>This app uses speech recognition to enable voice commands and language practice exercises.</string>
	<key>NSCameraUsageDescription</key>
	<string>Allow taking photos and videos to share as stories.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Allow selecting photos and videos from your library to share as stories.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Allow saving exported media to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app uses location to provide localized content and news for language learning.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>This app would like to track you across other companies' apps and websites to provide personalized learning content.</string>
	
	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>192.0.0.2</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>172.16.151.72</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	
	<!-- URL Schemes for OAuth / deep linking -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Google Sign-In reversed client ID FIRST -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.528041471934-bt96vs4ff11l1b50qq9j0brgnn9humkv</string>
			</array>
		</dict>
		<!-- App custom scheme -->
		<dict>
			<key>CFBundleURLName</key>
			<string>ai-learning-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ai-learning</string>
			</array>
		</dict>
	</array>
	
	<!-- Background modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	
	<!-- Supported languages -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
		<string>zh</string>
		<string>es</string>
		<string>el</string>
		<string>he</string>
		<string>de</string>
		<string>fr</string>
		<string>it</string>
	</array>
</dict>
</plist>
